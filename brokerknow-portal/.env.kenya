# Green Margin Capital demo tenant — client portal white-label build config.
# Build with:  npm run build -- --mode kenya --base=/ke/
# Placeholder brand (Nairobi Securities Exchange member) until real client assets arrive.
VITE_API_URL=/ke/api
VITE_BRAND_NAME=Green Margin Capital
VITE_BRAND_TAGLINE=Kenya · Client Portal
VITE_BRAND_LOGO=/ke/images/logo/client-logo-ke.svg
VITE_SUPPORT_EMAIL=support@greenmargin.demo
VITE_CURRENCY=KES
VITE_BRAND_EXCHANGE=NSE
VITE_LOGIN_HEADLINE=Green Margin Capital — Member of the Nairobi Securities Exchange
VITE_LOGIN_SERVICES=Stockbroking | Advisory | Research
