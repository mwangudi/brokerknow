# Rwanda demo tenant — white-label build config.
# Build with:  npm run build -- --mode rwanda
# Values are placeholders until the PM shares the real name/logo/address;
# swap VITE_BRAND_NAME and the logo file, then rebuild.
VITE_API_URL=/api
VITE_BRAND_NAME=Axis Rwanda
VITE_BRAND_TAGLINE=Institutional Portal
VITE_BRAND_LOGO=/images/logo/client-logo.png
VITE_SUPPORT_EMAIL=support@axis-rwanda.demo
VITE_CURRENCY=RWF
