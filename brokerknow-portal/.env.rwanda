VITE_CURRENCY=RWF
VITE_BRAND_EXCHANGE=RSE
VITE_LOGIN_HEADLINE=African Alliance Rwanda — Member of the Rwanda Stock Exchange
VITE_LOGIN_SERVICES=Stockbroking | Advisory | Research
