# African Alliance Rwanda demo tenant — white-label build config.
# Build with:  npm run build -- --mode rwanda --base=/rw/
# Real client: African Alliance Rwanda Limited (Rwanda Stock Exchange member).
VITE_API_URL=/rw/api
VITE_BRAND_NAME=African Alliance
